{
  "name": "keeper",
  "description": "Local-first watch tracker and universal watchlist.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "data": "vite-node pipeline/buildTitleIndex.ts -- 40000 && vite-node pipeline/buildSimilar.ts -- 8000 && vite-node pipeline/buildAvailability.ts -- IN",
    "data:titles": "vite-node pipeline/buildTitleIndex.ts --",
    "data:similar": "vite-node pipeline/buildSimilar.ts --",
    "data:availability": "vite-node pipeline/buildAvailability.ts --",
    "probe": "vite-node scripts/probe.ts --",
    "logs": "vite-node scripts/logs.ts --",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.20.27"
  }
}
